# Скопируй в .env и заполни. Файл .env в git не попадает.

# Домен, на который смотрит A-запись сервера. Caddy получит для него HTTPS-сертификат.
DOMAIN=shrek.example.ru

# Учётка ведущего (админка). Пароль из этого файла перезаписывается при каждом старте.
Accounts__Admin__Login=admin
Accounts__Admin__Password=

# Учётка телевизора: под ней открывается /tv.
Accounts__Viewer__Login=tv
Accounts__Viewer__Password=

# Даты для игры «Сколько дней имениннику» (по умолчанию уже стоят в appsettings.json).
# Party__BirthDate=2001-11-06
# Party__PartyDate=2026-11-06
